# ============================================================
# DATABASE
# ============================================================

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=document_rag_db
POSTGRES_USER=document_rag_user
POSTGRES_PASSWORD=change-me
POSTGRES_SSLMODE=prefer

# ============================================================
# HTTP API / CORS
# ============================================================

CORS_ALLOWED_ORIGINS='["http://localhost:5173","http://127.0.0.1:5173","https://projects.thiagomemelli.com.br"]'


# ============================================================
# RATE LIMITING
# ============================================================

DOCUMENT_UPLOAD_MAX_SIZE_BYTES=10485760
AUTH_REGISTER_RATE_LIMIT_PER_MINUTE=3
AUTH_LOGIN_RATE_LIMIT_PER_MINUTE=5
RAG_RATE_LIMIT_PER_MINUTE=5


# ============================================================
# CHUNKING
# ============================================================

CHUNK_SIZE=1000
CHUNK_OVERLAP=200


# ============================================================
# EMBEDDINGS
# ============================================================

EMBEDDING_PROVIDER=cloudflare
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
EMBEDDING_DIMENSION=512
EMBEDDING_DEVICE=cuda


# ============================================================
# CLOUDFLARE WORKERS AI
# ============================================================

CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here
CLOUDFLARE_EMBEDDING_MODEL=@cf/qwen/qwen3-embedding-0.6b
CLOUDFLARE_EMBEDDING_MAX_SEQUENCE_LENGTH=8192
CLOUDFLARE_EMBEDDING_BATCH_SIZE=32
CLOUDFLARE_TIMEOUT_SECONDS=30.0
CLOUDFLARE_MAX_ATTEMPTS=3
CLOUDFLARE_RETRY_BASE_DELAY_SECONDS=1.0


# ============================================================
# LLM INFERENCE SERVICE
# ============================================================

LLM_INFERENCE_BASE_URL=https://llm-inference-service-g4os.onrender.com
LLM_INFERENCE_PROVIDER=gemini
LLM_INFERENCE_MODEL=gemini-3.1-flash-lite
LLM_INFERENCE_TEMPERATURE=0.0
LLM_INFERENCE_MAX_TOKENS=2000
LLM_INFERENCE_TIMEOUT_SECONDS=120.0
LLM_INFERENCE_MAX_PROMPT_CHARACTERS=20000


# ============================================================
# QUERY TRANSFORMATION
# ============================================================

QUERY_TRANSFORMATION_TEMPERATURE=0.0
QUERY_TRANSFORMATION_MAX_TOKENS=2000
QUERY_TRANSFORMATION_MAX_GENERATED_QUERIES=2
QUERY_TRANSFORMATION_MAX_ATTEMPTS=2


# ============================================================
# AUTHENTICATION / JWT
# ============================================================

AUTH_JWT_SECRET=change-me
AUTH_JWT_ALGORITHM=HS256
AUTH_JWT_ISSUER=document-rag-service
AUTH_JWT_AUDIENCE=document-rag-frontend
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=480
